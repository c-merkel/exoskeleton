# Two Suits — docker-compose.yml template
# Generated by /exoskeleton-local. Replace placeholders (PROJECT_SLUG, WEB_IMAGE) with your project's values.
#
# Same shape as production. Volume mounts your source for live reload.

services:

  web:
    # Replace with your stack's base image (e.g. node:20, ruby:3.3, python:3.12, php:8.3-apache)
    image: <WEB_IMAGE>
    container_name: <PROJECT_SLUG>-web
    working_dir: /app
    volumes:
      - .:/app
    ports:
      - "8080:8080"
    environment:
      PROJECT_SLUG: <PROJECT_SLUG>
      DB_HOST: db
      DB_USER: ${DB_USER}
      DB_PASSWORD: ${DB_PASSWORD}
      DB_NAME: <PROJECT_SLUG>
    depends_on:
      db:
        condition: service_healthy
    restart: unless-stopped

  db:
    # Default: MariaDB 11 (matches the canonical Two Suits stack).
    # Swap to postgres:16 or another image if your project picked a different DB.
    image: mariadb:11
    container_name: <PROJECT_SLUG>-db
    environment:
      MARIADB_ROOT_PASSWORD: ${DB_ROOT_PASSWORD}
      MARIADB_DATABASE: <PROJECT_SLUG>
      MARIADB_USER: ${DB_USER}
      MARIADB_PASSWORD: ${DB_PASSWORD}
    volumes:
      - dbdata:/var/lib/mysql
    ports:
      - "3308:3306"
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 5s
      timeout: 5s
      retries: 12
    restart: unless-stopped

volumes:
  dbdata:
